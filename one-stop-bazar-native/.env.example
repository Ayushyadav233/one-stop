# Copy to .env and fill real values (never commit .env)
# Dev loop (emulator RudraEmulator)
# Emulator localhost -> 10.0.2.2, backend PORT=8787
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# Real phone same WiFi pe ho to apna LAN IP likho, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8787
# Mapbox public token (free account: account.mapbox.com)
# Tiles OSM ke hain to Mapbox tile usage = zero; token sirf SDK auth ke liye
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
